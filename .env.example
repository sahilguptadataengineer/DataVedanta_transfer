# Copy this file to .env.local (local development) and add the same values in Vercel > Project > Settings > Environment Variables.
# Both values are public by design (they end up in the browser). Never put secrets here.

# Google Apps Script web app URL (ends with /exec). See docs/APPS_SCRIPT_SETUP.md.
NEXT_PUBLIC_APPS_SCRIPT_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=
